{
  "name": "xreality-convert",
  "version": "1.4.1",
  "description": "Conversor local de referencias a activos 3D optimizados para Xreality y spatial computing",
  "author": "Arnaud Soulas",
  "license": "MIT",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c magenta,cyan \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "start": "npm run dev",
    "build:vite": "vite build",
    "build": "npm run build:vite && electron-builder",
    "test:runtime": "node --test electron/hunyuan-runtime.test.cjs",
    "test:engine": "/bin/zsh engine/test.sh",
    "test:ui": "npm run build:vite && electron scripts/ui-smoke.cjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.0",
    "concurrently": "9.2.1",
    "cross-env": "7.0.3",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "postcss": "8.5.15",
    "tailwindcss": "3.4.19",
    "vite": "6.4.3",
    "wait-on": "8.0.5"
  },
  "dependencies": {
    "@jscad/modeling": "2.13.0",
    "@jscad/stl-serializer": "2.1.23",
    "@phosphor-icons/react": "^2.1.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.185.0"
  },
  "build": {
    "appId": "com.xreality.convert",
    "productName": "Xreality Convert",
    "icon": "build/icon.icns",
    "asarUnpack": [
      "engine/server.py",
      "engine/setup.sh",
      "engine/paint_service.py",
      "engine/agentic_paint_service.py",
      "engine/pbr_glb.py",
      "engine/material_policy.py",
      "engine/asset_director.py",
      "engine/buffalo_strategy.py",
      "engine/openusd_export.py",
      "engine/reference_projection.py",
      "engine/m5_optimizer.py",
      "engine/requirements-macos.lock",
      "benchmarks/model-arena/run_agenticvibes_paint.py",
      "engine/Hunyuan3D-2.1-mlx/hy3dshape/hy3dshape/**/*",
      "engine/Hunyuan3D-2.1-mlx/hy3dpaint/**/*",
      "engine/AgenticVibes-Hunyuan3D-Paint/hy3dpaint/**/*"
    ],
    "files": [
      "build/**/*",
      "electron/**/*",
      "engine/server.py",
      "engine/setup.sh",
      "engine/paint_service.py",
      "engine/agentic_paint_service.py",
      "engine/pbr_glb.py",
      "engine/material_policy.py",
      "engine/asset_director.py",
      "engine/buffalo_strategy.py",
      "engine/openusd_export.py",
      "engine/reference_projection.py",
      "engine/m5_optimizer.py",
      "engine/requirements-macos.lock",
      "benchmarks/model-arena/run_agenticvibes_paint.py",
      "engine/Hunyuan3D-2.1-mlx/hy3dshape/hy3dshape/**/*",
      "!engine/Hunyuan3D-2.1-mlx/hy3dshape/hy3dshape/**/__pycache__/**/*",
      "!engine/Hunyuan3D-2.1-mlx/hy3dshape/hy3dshape/**/*.pyc",
      "engine/Hunyuan3D-2.1-mlx/hy3dpaint/**/*",
      "!engine/Hunyuan3D-2.1-mlx/hy3dpaint/**/__pycache__/**/*",
      "!engine/Hunyuan3D-2.1-mlx/hy3dpaint/**/*.pyc",
      "engine/AgenticVibes-Hunyuan3D-Paint/hy3dpaint/**/*",
      "!engine/AgenticVibes-Hunyuan3D-Paint/hy3dpaint/**/__pycache__/**/*",
      "!engine/AgenticVibes-Hunyuan3D-Paint/hy3dpaint/**/*.pyc",
      "!engine/AgenticVibes-Hunyuan3D-Paint/hy3dpaint/custom_rasterizer/build/**/*",
      "dist/**/*",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "extraResources": [
      {
        "from": "engine/Hunyuan3D-2.1-mlx/LICENSE",
        "to": "legal/Hunyuan3D-2.1-LICENSE.txt"
      },
      {
        "from": "engine/Hunyuan3D-2.1-mlx/Notice.txt",
        "to": "legal/Hunyuan3D-2.1-NOTICE.txt"
      },
      {
        "from": "engine/AgenticVibes-Hunyuan3D-Paint/LICENSE",
        "to": "legal/AgenticVibes-Hunyuan3D-Paint-LICENSE.txt"
      },
      {
        "from": "engine/AgenticVibes-Hunyuan3D-Paint/LICENSE-MIT",
        "to": "legal/AgenticVibes-Hunyuan3D-Paint-LICENSE-MIT.txt"
      },
      {
        "from": "engine/AgenticVibes-Hunyuan3D-Paint/NOTICE",
        "to": "legal/AgenticVibes-Hunyuan3D-Paint-NOTICE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "legal/THIRD_PARTY_NOTICES.txt"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.graphics-design"
    }
  }
}
